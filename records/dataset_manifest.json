  "excluded": {
    "periodic_hills_case_0p8": {
      "category": "data_incomplete",
      "reason": "DNS file has all-zero <u'v'>; the near-wall budget ratio and the cancellation parameter eps are undefined. The Re_b=5600 case_1p0 variant (with full Reynolds stresses) is the periodic-hills representative in the core benchmark.",
      "mechanism_present": null
    },
    "periodic_hills_case_1p0_refined": {
      "category": "data_incomplete",
      "reason": "All-zero <u'v'> in the DNS file (see periodic_hills_case_0p8).",
      "mechanism_present": null
    },
    "periodic_hills_case_1p2": {
      "category": "data_incomplete",
      "reason": "All-zero <u'v'> in the DNS file (see periodic_hills_case_0p8).",
      "mechanism_present": null
    },
    "kth_3d_diffuser_Re18000": {
      "category": "out_of_scope_3d",
      "reason": "Fully three-dimensional separating flow (Stanford/KTH 3D diffuser). The TBLE/ODE, the 1D streamwise momentum budget, and the eps(x) diagnostic all assume a quasi-2D (streamwise + wall-normal) balance; a 3D diffuser has first-order spanwise (lateral-divergence) momentum transport the model cannot represent. The ODE prediction is even anti-correlated with the DNS (Pearson r = -0.78 over 7 stations), confirming the 1D model is simply the wrong reduction here. Excluded as outside the stated quasi-2D scope, not as a hidden failure of the cancellation mechanism.",
      "evidence": {
        "n_stations": 7,
        "ode_r2": -22.97,
        "pred_truth_corr": -0.78,
        "eps_median": 0.21
      },
      "mechanism_present": false
    },
    "separation_bubble_caseE": {
      "category": "processed_artifact",
      "reason": "The ODE prediction is exactly proportional to the DNS wall stress (Pearson r = 1.000; after a single linear rescale R^2 = 0.9998), i.e. the model reproduces the SHAPE of tau_w(x) perfectly but the absolute scale of this one processed product is off by a constant factor (~2.25x) -- the signature of a units/normalization inconsistency in this artifact, which drives R^2 negative. The cancellation parameter stays O(10) at every station (eps_median ~ 26, min 0.82), so the domain-wide cancellation regime is absent. Excluded as not benchmark-grade; it is neither a mechanism failure nor a counterexample to the periodic-hills claim. The sibling cases A and B (same family, clean scale) give R^2 = 0.999.",
      "evidence": {
        "n_stations": 62,
        "ode_r2": -1.61,
        "pred_truth_corr": 1.0,
        "r2_after_linear_rescale": 0.9998,
        "scale_factor": 2.25,
        "eps_median": 26.2,
        "eps_min": 0.82,
        "f_sep": 0.0
      },
      "mechanism_present": false
    },
    "separation_bubble_caseA": {
      "category": "redundant_positive",
      "reason": "Exploratory case consistent with ODE success (R^2 = 0.999, eps median ~ 8e2); not added to the curated extended table to avoid over-representing one synthetic separation-bubble family.",
      "evidence": {
        "ode_r2": 0.999
      },
      "mechanism_present": false
    },
    "separation_bubble_caseB": {
      "category": "redundant_positive",
      "reason": "Exploratory case consistent with ODE success (R^2 = 1.000, eps median ~ 23); redundant with the curated extended table.",
      "evidence": {
        "ode_r2": 1.0
      },
      "mechanism_present": false
    },
    "gaussian_bump_Re1M": {
      "category": "redundant_positive",
      "reason": "Lower-Reynolds companion of the Gaussian bump; the Re_L = 2e6 case (gaussian_bump_Re2M, R^2 = 0.975) is the extended-table representative. Re_L = 1e6 gives R^2 = 0.986, consistent with ODE success.",
      "evidence": {
        "ode_r2": 0.986
      },
      "mechanism_present": false
    },
    "conv_div_channel_vendor64": {
      "category": "duplicate_product",
      "reason": "A 64-station processed copy of the converging-diverging channel exists in the vendor results directory. The manuscript uses the 51-station new_data_download product (Table 2: 51 stations, R^2 = 0.934). No manuscript analysis reads the 64-station copy; the manifest-driven momentum-budget script lists it as IGNORED.",
      "mechanism_present": false
    }
  }
